{
  "name": "go-kiro-gateway-models",
  "version": "0.1.0",
  "description": "Dynamic go-kiro-gateway model provider for Pi and Oh My Pi",
  "license": "AGPL-3.0-only",
  "type": "module",
  "keywords": [
    "pi-package",
    "omp-plugin",
    "go-kiro-gateway"
  ],
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/omp.js"
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/build.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test .test-dist/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.3.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@oh-my-pi/pi-coding-agent": "18.0.11"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@oh-my-pi/pi-coding-agent": "18.0.11",
    "@types/node": "22.19.19",
    "bun": "1.3.14",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
